describe('parseDeepLink - Edge Cases', () => {
  test('should accept amount=0', () => {
    const result = parseDeepLink('ton://transfer/UQAZZNjwN-h6UbWmu1P10bG-p-_N_JSjGdtnJ44cMFdqsIaw?amount=0')

    expect(result.error).toBeUndefined()
    expect(result.transfer).toBeDefined()
    expect(result.transfer?.transaction.amount).toBe(0n)
  })

  test('should reject invalid init format in URL', () => {
    const result = parseDeepLink('ton://transfer/UQAZZNjwN-h6UbWmu1P10bG-p-_N_JSjGdtnJ44cMFdqsIaw?amount=1000000000&init=invalid-base64!!!')

    expect(result.transfer).toBeUndefined()
    expect(result.error).toBeDefined()
    expect(result.error?.message).toMatch(/init|StateInit|BOC/i)
  })

  test('should reject invalid/non-numeric exp', () => {
    const result = parseDeepLink('ton://transfer/UQAZZNjwN-h6UbWmu1P10bG-p-_N_JSjGdtnJ44cMFdqsIaw?amount=1000000000&exp=invalid')

    expect(result.transfer).toBeUndefined()
    expect(result.error).toBeDefined()
    expect(result.error?.message).toContain('exp')
  })

  test('should accept very large amount near uint64 max', () => {
    const result = parseDeepLink('ton://transfer/UQAZZNjwN-h6UbWmu1P10bG-p-_N_JSjGdtnJ44cMFdqsIaw?amount=18446744073709551615')

    expect(result.error).toBeUndefined()
    expect(result.transfer).toBeDefined()
    expect(result.transfer?.transaction.amount).toBe(18446744073709551615n)
  })

  test('should reject decimal/fractional amount', () => {
    const result = parseDeepLink('ton://transfer/UQAZZNjwN-h6UbWmu1P10bG-p-_N_JSjGdtnJ44cMFdqsIaw?amount=123.456')

    expect(result.transfer).toBeUndefined()
    expect(result.error).toBeDefined()
    expect(result.error?.message).toContain('amount')
  })
})

describe('parseDeepLink - Additional Validation', () => {
  test('should accept parameters in any order', () => {
    const result1 = parseDeepLink('ton://transfer/UQAZZNjwN-h6UbWmu1P10bG-p-_N_JSjGdtnJ44cMFdqsIaw?amount=1&text=Hello')
    const result2 = parseDeepLink('ton://transfer/UQAZZNjwN-h6UbWmu1P10bG-p-_N_JSjGdtnJ44cMFdqsIaw?text=Hello&amount=1')

    expect(result1.error).toBeUndefined()
    expect(result2.error).toBeUndefined()
    expect(result1.transfer?.params).toEqual(result2.transfer?.params)
  })

  test('should reject parameter names with wrong case', () => {
    const result = parseDeepLink('ton://transfer/UQAZZNjwN-h6UbWmu1P10bG-p-_N_JSjGdtnJ44cMFdqsIaw?Amount=1000000000')

    expect(result.transfer).toBeUndefined()
    expect(result.error).toBeDefined()
    expect(result.error?.message).toContain('unknown')
  })

  test('should reject amount with leading zeros', () => {
    const result = parseDeepLink('ton://transfer/UQAZZNjwN-h6UbWmu1P10bG-p-_N_JSjGdtnJ44cMFdqsIaw?amount=0123')

    expect(result.transfer).toBeUndefined()
    expect(result.error).toBeDefined()
    expect(result.error?.message).toMatch(/amount|leading zero/i)
  })
})
